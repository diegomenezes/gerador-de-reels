generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TopicStatus {
  new
  scripted
  recorded
  discarded
}

enum TopicKind {
  question
  polemic
}

model Group {
  id        String    @id @default(cuid())
  remoteJid String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  waMessageId String
  author      String?
  text        String
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([groupId, waMessageId])
  @@index([timestamp])
}

model Topic {
  id         String         @id @default(cuid())
  title      String
  summary    String
  frequency  Int            @default(1)
  score      Float          @default(0)
  dateBucket String
  status     TopicStatus    @default(new)
  kind       TopicKind      @default(question)
  userNotes  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  examples   TopicExample[]
  scripts    Script[]

  @@index([dateBucket])
  @@index([status])
}

model TopicExample {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model Script {
  id           String   @id @default(cuid())
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content      String
  hooks        String   @default("[]")
  selectedHook String?
  caption      String?
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
}

model ModerationSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(true)
  deleteMode     Boolean  @default(false)
  notifyNumber   String   @default("")
  announceDelete Boolean  @default(false)
  announceText   String   @default("*Mensagem apagada automaticamente* pelo BOT Moderador. Se você acha que foi um engano comunique um dos admins, leia as regras do grupo na descrição.")
  updatedAt      DateTime @updatedAt
}

model BlockedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model WhitelistLink {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
}

model AdminLink {
  id        String   @id @default(cuid())
  urlKey    String   @unique
  sample    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ModerationEvent {
  id          String   @id @default(cuid())
  groupJid    String
  waMessageId String
  groupName   String
  author      String
  text        String
  matchedUrl  String
  action      String
  detail      String?
  messageAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([groupJid, waMessageId])
  @@index([createdAt])
}

model JobRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  success       Boolean   @default(false)
  running       Boolean   @default(true)
  stage         String    @default("Iniciando...")
  messagesIn    Int       @default(0)
  messagesKept  Int       @default(0)
  topicsCreated Int       @default(0)
  error         String?
}
