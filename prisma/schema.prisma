generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TopicStatus {
  new
  scripted
  recorded
  discarded
}

enum TopicKind {
  question
  polemic
  viral
  youtube
}

model Group {
  id        String    @id @default(cuid())
  remoteJid String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  waMessageId String
  author      String?
  text        String
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([groupId, waMessageId])
  @@index([timestamp])
}

model Topic {
  id         String         @id @default(cuid())
  title      String
  summary    String
  frequency  Int            @default(1)
  score      Float          @default(0)
  dateBucket String
  status     TopicStatus    @default(new)
  kind       TopicKind      @default(question)
  userNotes  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  examples   TopicExample[]
  scripts    Script[]

  @@index([dateBucket])
  @@index([status])
}

model TopicExample {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text      String
  // vídeo de referência (ideias vindas de TikTok, Reels e YouTube)
  url       String?
  createdAt DateTime @default(now())
}

model Script {
  id           String   @id @default(cuid())
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content      String
  hooks        String   @default("[]")
  selectedHook String?
  caption      String?
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
}

model ModerationSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(true)
  deleteMode     Boolean  @default(false)
  notifyNumber   String   @default("")
  announceDelete Boolean  @default(false)
  announceText   String   @default("*Mensagem apagada automaticamente* pelo BOT Moderador. Se você acha que foi um engano comunique um dos admins, leia as regras do grupo na descrição.")
  updatedAt      DateTime @updatedAt
}

model BlockedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model UnknownLink {
  id            String   @id @default(cuid())
  domain        String   @unique
  sample        String
  groupName     String
  author        String
  text          String
  count         Int      @default(1)
  lastMessageId String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([lastSeenAt])
}

model WhitelistLink {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
}

model AdminLink {
  id        String   @id @default(cuid())
  urlKey    String   @unique
  sample    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ModerationEvent {
  id             String    @id @default(cuid())
  groupJid       String
  waMessageId    String
  groupName      String
  author         String
  authorName     String    @default("")
  authorPhone    String    @default("")
  text           String
  matchedUrl     String
  action         String
  detail         String?
  participant    String    @default("")
  participantAlt String    @default("")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  messageAt      DateTime
  createdAt      DateTime  @default(now())

  @@unique([groupJid, waMessageId])
  @@index([createdAt])
  @@index([action, nextAttemptAt])
}

model JobRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  success       Boolean   @default(false)
  running       Boolean   @default(true)
  stage         String    @default("Iniciando...")
  messagesIn    Int       @default(0)
  messagesKept  Int       @default(0)
  topicsCreated Int       @default(0)
  videosIn      Int       @default(0)
  // daily (automático) | group | viral | youtube
  mode          String    @default("daily")
  error         String?
}

// Fontes de ideias e busca de vídeos virais (linha única "default")
model AppSettings {
  id             String   @id @default("default")
  groupSource    Boolean  @default(true)
  viralSource    Boolean  @default(true)
  // termos por idioma em JSON: { "pt": [...], "en": [...], "es": [...] }
  viralTerms     String   @default("{\"pt\":[\"dicas impressão 3d\"],\"en\":[\"3d printing tips\"],\"es\":[\"consejos impresión 3d\"]}")
  viralPerSearch Int      @default(10)
  // redes ligadas na busca diária, separadas por vírgula
  viralPlatforms String   @default("tiktok,instagram,youtube")
  // perfis ignorados (os seus próprios), separados por vírgula
  ignoreAuthors  String   @default("primeirasimpressoes.3d")
  updatedAt      DateTime @updatedAt
}

model ViralVideo {
  id          String    @id @default(cuid())
  platform    String // tiktok | instagram | youtube | youtube-long
  externalId  String
  url         String
  caption     String
  author      String?
  views       Int       @default(0)
  likes       Int       @default(0)
  comments    Int       @default(0)
  language    String
  term        String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  usedAt      DateTime?

  @@unique([platform, externalId])
  @@index([fetchedAt])
}
